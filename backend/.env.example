# ========================================================
# Internet Museum API — Environment Variables (.env.example)
# ========================================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=internet_museum
DB_USER=root
DB_PASSWORD=

# Optional direct database connection string (takes precedence if provided)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/internet_museum?charset=utf8mb4
# For lightweight local testing or offline demo:
# DATABASE_URL=sqlite:///./internet_museum.db

# API and Server Configuration
API_PORT=8000
DEBUG=true

# JWT Authentication Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
